# ===========================================================================
# Telegram Bot Configuration
# ===========================================================================
# Bot token received from @BotFather in Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Telegram User ID where automated digests will be delivered
MY_TELEGRAM_ID=123456789

# Telegram channels to scrape (comma-separated usernames without @)
TG_CHANNELS=naebnet,kiev_levyy_bereg

# Send images alongside digest (true/false) and maximum number of images
SEND_IMAGES=true
MAX_TOTAL_IMAGES=5

# ===========================================================================
# LLM Providers Configuration
# ===========================================================================
# Primary LLM: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Fallback LLM: OpenRouter (used automatically if Gemini fails or hits quota)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_HTTP_REFERER=https://github.com/ervins324/news-parcer
OPENROUTER_TITLE=News Parcer Telegram Bot

# ===========================================================================
# Scheduler Configuration
# ===========================================================================
# Timezone for scheduled runs (e.g. Europe/Kyiv, UTC)
TIMEZONE=Europe/Kyiv

# Scheduled times of day (24-hour format HH:MM, separated by commas)
SCHEDULE_TIMES=09:00, 20:00

# Whether to generate and send a digest immediately when the bot starts (true/false)
RUN_ON_STARTUP=false

# ===========================================================================
# Storage Configuration
# ===========================================================================
# Path to store seen post IDs (in Docker this defaults to /app/data/seen_posts.json)
SEEN_POSTS_FILE=seen_posts.json
